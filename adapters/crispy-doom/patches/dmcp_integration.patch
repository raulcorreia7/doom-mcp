diff --git a/CMakeLists.txt b/CMakeLists.txt
index f2f41e0e..365184ab 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -36,6 +36,15 @@ option(CMAKE_FIND_PACKAGE_PREFER_CONFIG
 option(ENABLE_SDL2_NET "Enable SDL2_net" On)
 option(ENABLE_SDL2_MIXER "Enable SDL2_mixer" On)
 
+# DMCP integration
+option(DMCP_ENABLE "Enable DMCP MCP server integration" Off)
+set(DMCP_INCLUDE_DIR "" CACHE PATH "Path to DMCP include directory")
+set(DMCP_LIB_DIR "" CACHE PATH "Path to DMCP library directory")
