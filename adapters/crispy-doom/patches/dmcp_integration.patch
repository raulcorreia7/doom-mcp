diff --git a/src/doom/CMakeLists.txt b/src/doom/CMakeLists.txt
index 4545738a..41c45b04 100644
--- a/src/doom/CMakeLists.txt
+++ b/src/doom/CMakeLists.txt
@@ -83,6 +83,49 @@ add_library(doom STATIC
 
 target_include_directories(doom PRIVATE "../" "${CMAKE_CURRENT_BINARY_DIR}/../../")
 
+if(DMCP_ENABLE)
+    set(DMCP_ADAPTER_DIR "${CMAKE_SOURCE_DIR}/../adapters/chocolate-doom")
+
+    target_sources(doom PRIVATE
+        "${DMCP_ADAPTER_DIR}/dmcp_adapter.c"
+        "${DMCP_ADAPTER_DIR}/dmcp_ascii.c"
+        "${DMCP_ADAPTER_DIR}/state_player.c"
+        "${DMCP_ADAPTER_DIR}/state_level.c"
+        "${DMCP_ADAPTER_DIR}/state_enemies.c"
+        "${DMCP_ADAPTER_DIR}/commands.c"
+    )
+
+    target_include_directories(doom PRIVATE
+        "${DMCP_INCLUDE_DIR}"
+        "${DMCP_ADAPTER_DIR}"
+        "${CMAKE_SOURCE_DIR}/src"
+        "${CMAKE_SOURCE_DIR}/src/doom"
+    )
+
+    target_compile_definitions(doom PRIVATE CHOCOLATE_DOOM_BUILD)
+
+    # Find DMCP library (dmcp_core links mcp_generic transitively)
+    find_library(DMCP_CORE_LIB dmcp_core PATHS "${DMCP_LIB_DIR}" REQUIRED)
+
+    target_link_libraries(doom ${DMCP_CORE_LIB})
+
+    # For static builds, link C++ stdlib and transitive dependencies
+    if(DMCP_CORE_LIB MATCHES "\\.a$")
+        find_library(MCP_GENERIC_LIB mcp_generic PATHS "${DMCP_LIB_DIR}" REQUIRED)
+        find_library(YYJSON_LIB yyjson PATHS "${DMCP_LIB_DIR}/_deps/yyjson-build" REQUIRED)
+        find_library(USOCKETS_LIB uSockets PATHS "${DMCP_LIB_DIR}" REQUIRED)
+        find_package(OpenSSL REQUIRED)
+        target_link_libraries(doom
+            ${MCP_GENERIC_LIB}
+            ${YYJSON_LIB}
+            ${USOCKETS_LIB}
+            OpenSSL::SSL
+            OpenSSL::Crypto
+            stdc++
+        )
+    endif()
+endif()
+
 if (DEFINED EMSCRIPTEN)
     set(SDL_FLAGS "-s USE_SDL=2")
     if(ENABLE_SDL2_MIXER)
diff --git a/src/doom/d_main.c b/src/doom/d_main.c
index 2092987d..a8a35095 100644
--- a/src/doom/d_main.c
+++ b/src/doom/d_main.c
@@ -79,6 +79,63 @@
 
 #include "d_main.h"
 
+#ifdef DMCP
+#include "dmcp_adapter.h"
+dmcp_chocolate_t *g_dmcp_ctx = NULL;
+
+static void DMCP_Shutdown(void)
+{
+    if (g_dmcp_ctx)
+    {
+        dmcp_chocolate_destroy(g_dmcp_ctx);
+        g_dmcp_ctx = NULL;
+    }
+}
+
+static int DMCP_PortOverride(void)
+{
+    int p;
+    char *end;
+    long port;
+
+    p = M_CheckParmWithArgs("-dmcp_port", 1);
+    if (!p)
+    {
+        p = M_CheckParmWithArgs("-dmcp-port", 1);
+    }
+
+    if (!p)
+    {
+        return 0;
+    }
+
+    end = NULL;
+    port = strtol(myargv[p + 1], &end, 10);
+    if (end == myargv[p + 1] || *end != '\0' || port < 1 || port > 65535)
+    {
+        I_Error("Invalid DMCP port '%s' (expected 1-65535)", myargv[p + 1]);
+    }
+
+    return (int) port;
+}
+
+static dmcp_chocolate_t *DMCP_CreateContext(void)
+{
+    dmcp_chocolate_config_t dmcp_cfg;
+    int dmcp_port;
+
+    dmcp_cfg = dmcp_chocolate_config_default();
+    dmcp_port = DMCP_PortOverride();
+
+    if (dmcp_port > 0)
+    {
+        dmcp_cfg.base.port = dmcp_port;
+    }
+
+    return dmcp_chocolate_create(&dmcp_cfg);
+}
+#endif
+
 #include "doom_icon.c"
 
 //
